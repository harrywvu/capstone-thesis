digraph OverFlowIterations {
  graph [layout=neato, overlap=true, splines=false, pad="0.12", bgcolor="white", outputorder=edgesfirst];
  node [shape=box, style="rounded,filled", fillcolor="#F2F6F7", color="#3F6670", fontname="Helvetica", fontsize=16, penwidth=1.3, height=0.66, margin="0.12,0.08", pin=true];
  edge [color="#3F6670", arrowsize=0.75, penwidth=1.5];
  plan   [pos="0,210!", width=1.65, label="Plan"];
  design [pos="155,210!", width=1.65, label="Design"];
  build  [pos="310,210!", width=1.65, label="Implement"];
  test   [pos="465,210!", width=1.65, label="Test"];
  review [pos="620,210!", width=1.65, label="Review"];
  plan -> design -> build -> test -> review;
  loop_right [pos="620,295!", shape=point, width=0.01, height=0.01, style=invis, label=""];
  loop_left  [pos="0,295!", shape=point, width=0.01, height=0.01, style=invis, label=""];
  review -> loop_right [style=dashed, color="#8C6A4A", dir=none];
  loop_right -> loop_left [style=dashed, color="#8C6A4A", dir=none, label="feedback and revision", fontname="Helvetica", fontsize=14, fontcolor="#8C6A4A"];
  loop_left -> plan [style=dashed, color="#8C6A4A"];
  growth [pos="310,95!", shape=plaintext, style="", label="Each cycle produces a tested increment of OverFlow", fontname="Helvetica", fontsize=15, fontcolor="#30383B"];
  inc1 [pos="0,0!", width=1.95, height=0.85, fontsize=14, fillcolor="#E8EFF1", label="Increment 1\nMap and barangays"];
  inc2 [pos="205,0!", width=1.95, height=0.85, fontsize=14, fillcolor="#E8EFF1", label="Increment 2\nRoutes and centers"];
  inc3 [pos="410,0!", width=1.95, height=0.85, fontsize=14, fillcolor="#E8EFF1", label="Increment 3\nFlood and radar layers"];
  inc4 [pos="615,0!", width=1.95, height=0.85, fontsize=14, fillcolor="#E8EFF1", label="Increment 4\nScenario comparison"];
  inc1 -> inc2 -> inc3 -> inc4;
}
